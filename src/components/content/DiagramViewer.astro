---
import CornerBrackets from '../hud/CornerBrackets.astro';

interface Props {
  svg: string;
  title: string;
  caption?: string;
  height?: string;
}

const { svg, title, caption, height = 'clamp(20rem, 62vh, 40rem)' } = Astro.props;

const markup = svg
  .replace(/<\?xml[^>]*\?>/, '')
  .replace(/<!DOCTYPE[^>]*>/, '')
  .replace(/<svg([^>]*)\swidth="[^"]*"/, '<svg$1')
  .replace(/<svg([^>]*)\sheight="[^"]*"/, '<svg$1')
  .trim();
---

<div class="entry-embed not-prose">
  <figure class="dgm" data-diagram style={`--dgm-h:${height}`}>
    <div class="dgm-bar">
      <span class="dgm-title">{title}</span>
      <div class="dgm-tools">
        <button type="button" data-act="out" aria-label="Zoom out">&minus;</button>
        <button type="button" data-act="in" aria-label="Zoom in">+</button>
        <button type="button" data-act="fit" aria-label="Fit diagram">Fit</button>
        <button type="button" data-act="full" aria-label="Fullscreen">Full</button>
      </div>
    </div>
    <div class="dgm-stage" tabindex="0" role="img" aria-label={title}>
      <div class="dgm-canvas" set:html={markup} />
      <p class="dgm-hint" data-hint>Drag to pan &middot; pinch or &#8984;/Ctrl + scroll to zoom</p>
    </div>
    {caption && <figcaption>{caption}</figcaption>}
    <CornerBrackets size={12} inset={-1} color="var(--color-indigo)" />
  </figure>
</div>

<script>
  const MIN = 0.15;
  const MAX = 14;

  function setup(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('.dgm-stage')!;
    const canvas = root.querySelector<HTMLElement>('.dgm-canvas')!;
    const svg = canvas.querySelector('svg');
    const hint = root.querySelector<HTMLElement>('[data-hint]');
    if (!svg) return;

    const box = (svg.getAttribute('viewBox') || '0 0 1000 1000').split(/\s+/).map(Number);
    const w = box[2];
    const h = box[3];
    svg.setAttribute('width', String(w));
    svg.setAttribute('height', String(h));

    let scale = 1;
    let tx = 0;
    let ty = 0;
    let base = 1;

    const apply = () => {
      canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    };

    const fit = () => {
      const r = stage.getBoundingClientRect();
      base = Math.min(r.width / w, r.height / h) * 0.96;
      scale = base;
      tx = (r.width - w * scale) / 2;
      ty = (r.height - h * scale) / 2;
      apply();
    };

    const zoomAt = (factor: number, cx: number, cy: number) => {
      const next = Math.min(MAX, Math.max(Math.min(MIN, base * 0.8), scale * factor));
      const r = stage.getBoundingClientRect();
      const px = cx - r.left;
      const py = cy - r.top;
      tx = px - ((px - tx) / scale) * next;
      ty = py - ((py - ty) / scale) * next;
      scale = next;
      apply();
    };

    const center = () => {
      const r = stage.getBoundingClientRect();
      return [r.left + r.width / 2, r.top + r.height / 2] as const;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const act = btn.dataset.act;
        if (act === 'in') zoomAt(1.4, ...center());
        else if (act === 'out') zoomAt(1 / 1.4, ...center());
        else if (act === 'fit') fit();
        else if (act === 'full') {
          if (document.fullscreenElement) document.exitFullscreen();
          else root.requestFullscreen?.();
        }
      });
    });

    stage.addEventListener(
      'wheel',
      (e) => {
        if (!e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        zoomAt(Math.exp(-e.deltaY * 0.0025), e.clientX, e.clientY);
      },
      { passive: false },
    );

    stage.addEventListener('dblclick', (e) => {
      e.preventDefault();
      zoomAt(1.7, e.clientX, e.clientY);
    });

    const pointers = new Map<number, { x: number; y: number }>();
    let pinch = 0;

    stage.addEventListener('pointerdown', (e) => {
      stage.setPointerCapture(e.pointerId);
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      stage.classList.add('is-grabbing');
      hint?.classList.add('is-gone');
    });

    stage.addEventListener('pointermove', (e) => {
      const prev = pointers.get(e.pointerId);
      if (!prev) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinch) zoomAt(dist / pinch, (a.x + b.x) / 2, (a.y + b.y) / 2);
        pinch = dist;
        return;
      }

      tx += e.clientX - prev.x;
      ty += e.clientY - prev.y;
      apply();
    });

    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinch = 0;
      if (!pointers.size) stage.classList.remove('is-grabbing');
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);

    stage.addEventListener('keydown', (e) => {
      const step = 60;
      if (e.key === '+' || e.key === '=') zoomAt(1.3, ...center());
      else if (e.key === '-') zoomAt(1 / 1.3, ...center());
      else if (e.key === '0') fit();
      else if (e.key === 'ArrowLeft') tx += step;
      else if (e.key === 'ArrowRight') tx -= step;
      else if (e.key === 'ArrowUp') ty += step;
      else if (e.key === 'ArrowDown') ty -= step;
      else return;
      e.preventDefault();
      apply();
    });

    let raf = 0;
    new ResizeObserver(() => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        if (Math.abs(scale - base) < 0.001) fit();
      });
    }).observe(stage);

    fit();
  }

  document.querySelectorAll<HTMLElement>('[data-diagram]').forEach(setup);
</script>

<style>
  .dgm {
    position: relative;
    margin: 0.5rem auto 1rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .dgm-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line);
    padding: 0.6rem 0.9rem;
  }

  .dgm-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .dgm-tools {
    display: flex;
    gap: 0.35rem;
  }

  .dgm-tools button {
    min-width: 2rem;
    border: 1px solid var(--color-line);
    background: transparent;
    padding: 0.2rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-muted);
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease-out-hud),
      border-color var(--dur-micro) var(--ease-out-hud);
  }

  .dgm-tools button:hover {
    color: var(--color-ink);
    border-color: var(--color-indigo);
  }

  .dgm-stage {
    position: relative;
    height: var(--dgm-h);
    overflow: hidden;
    background: #0e0e11;
    cursor: grab;
    touch-action: none;
  }

  .dgm-stage:focus-visible {
    outline: 1px solid var(--color-indigo);
    outline-offset: -1px;
  }

  .dgm-stage.is-grabbing {
    cursor: grabbing;
  }

  .dgm-canvas {
    transform-origin: 0 0;
    width: max-content;
    user-select: none;
  }

  .dgm-canvas :global(svg) {
    display: block;
  }

  .dgm-hint {
    position: absolute;
    right: 0.6rem;
    bottom: 0.5rem;
    margin: 0;
    border: 1px solid var(--color-line);
    background: rgba(9, 9, 11, 0.85);
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-faint);
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-out-hud);
  }

  .dgm-hint.is-gone {
    opacity: 0;
  }

  .dgm figcaption {
    border-top: 1px solid var(--color-line);
    padding: 0.6rem 0.9rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .dgm:fullscreen {
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
  }

  .dgm:fullscreen .dgm-stage {
    height: auto;
    flex: 1;
  }
</style>
