---
import { site, socials } from '../../config/site';
import Button from '../ui/Button.astro';
import SocialIcon from '../ui/SocialIcon.astro';

const year = new Date().getFullYear();
---

<footer class="relative border-t border-line bg-surface/40">
  <div class="container-hud">
    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-6 py-8">
      <p class="hud-label">© {year} {site.name}</p>

      <div class="flex flex-wrap items-center gap-x-8 gap-y-6">
        <ul class="flex items-center gap-x-6">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="link-hud inline-flex text-muted hover:text-ink"
                  aria-label={s.label}
                  rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  target={s.href.startsWith('http') ? '_blank' : undefined}
                >
                  <SocialIcon
                    label={s.label}
                    class={
                      s.label === 'Email'
                        ? 'h-10 w-10'
                        : s.label === 'GitHub'
                          ? 'h-9 w-9'
                          : 'h-8 w-8'
                    }
                  />
                </a>
              </li>
            ))
          }
        </ul>

        <Button
          href={site.resume}
          external
          variant="ghost"
          class="!text-muted !border-line hover:!border-faint hover:!text-ink"
        >
          Resume
        </Button>
      </div>
    </div>
  </div>
</footer>
