---
import { site } from '../../config/site';
import { withBase } from '../../config/paths';

// Breadcrumb trail from the current path, rendered as a shell command so the
// header reads like a terminal prompt: `caleb@portfolio:~$ cd /fsae/entry`.
// The home page shows the domain instead of a `cd`.
const rel = Astro.url.pathname.slice(withBase('/').length).replace(/\/+$/, '');
const segments = rel ? rel.split('/') : [];
const host = site.name.replace(/\s+/g, '').toLowerCase();
// First-level sections live on the one-page home, so their crumb points at the
// on-page anchor; the last segment is the current page and is not a link.
const crumbHref = (i: number): string | undefined => {
  if (i === segments.length - 1) return undefined;
  const seg = segments[i];
  if (seg === 'fsae') return '/#fsae';
  if (seg === 'projects') return '/#projects';
  return '/' + segments.slice(0, i + 1).join('/');
};
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
  <nav class="container-hud flex h-16 items-center" aria-label="Primary">
    <div class="flex min-w-0 items-baseline gap-1.5 overflow-hidden font-mono text-sm tracking-wide">
      <a
        href={withBase('/')}
        class="shrink-0 transition-colors hover:brightness-110"
        aria-label={`${site.name}, home`}
      >
        <span class="text-accent">caleb</span><span class="hidden text-faint sm:inline">@portfolio</span><span
          class="text-faint">:~$</span
        >
      </a>

      {
        segments.length === 0 ? (
          <span class="min-w-0 truncate text-ink">
            {host}
            <span class="text-faint">.com</span>
          </span>
        ) : (
          <span class="flex min-w-0 items-baseline">
            <span class="shrink-0 pr-1 text-faint">cd</span>
            {segments.map((seg, i) => {
              const href = crumbHref(i);
              return (
                <span class="flex min-w-0 items-baseline">
                  <span class="text-faint" aria-hidden="true">
                    /
                  </span>
                  {href ? (
                    <a
                      href={withBase(href)}
                      class="shrink-0 text-muted transition-colors hover:text-ink"
                    >
                      {seg}
                    </a>
                  ) : (
                    <span
                      class="min-w-0 max-w-[42vw] truncate text-ink"
                      aria-current="page"
                    >
                      {seg}
                    </span>
                  )}
                </span>
              );
            })}
          </span>
        )
      }

      <span
        class="term-cursor ml-0.5 inline-block h-[1.05em] w-[0.55ch] shrink-0 translate-y-[0.15em] bg-accent"
        aria-hidden="true"
      >
      </span>
    </div>
  </nav>
</header>

<style>
  .term-cursor {
    animation: term-blink 1.05s steps(1) infinite;
  }
  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .term-cursor {
      animation: none;
    }
  }
</style>
