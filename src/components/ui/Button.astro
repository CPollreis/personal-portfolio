---
import { withBase } from '../../config/paths';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  size?: 'sm' | 'md';
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className = '',
} = Astro.props;

const sizing =
  size === 'sm'
    ? 'gap-2 px-3.5 py-1.5 text-[0.6875rem]'
    : 'gap-2.5 px-5 py-2.5 text-xs';
const base = `group relative inline-flex items-center overflow-hidden font-mono uppercase tracking-widest transition-colors duration-200 ${sizing}`;
const styles =
  variant === 'primary'
    ? 'bg-accent text-ink hover:bg-cyan hover:text-bg'
    : 'border border-line text-ink hover:border-cyan hover:text-cyan';
---

<a
  href={withBase(href)}
  class={`${base} ${styles} ${className}`}
  rel={external ? 'noopener noreferrer' : undefined}
  target={external ? '_blank' : undefined}
>
  {
    variant === 'primary' && (
      <span
        class="pointer-events-none absolute inset-y-0 -left-1/2 w-1/3 -skew-x-12 bg-ink/25 opacity-0 transition-all duration-500 group-hover:left-[110%] group-hover:opacity-100"
        aria-hidden="true"
      />
    )
  }
  <slot />
  <svg
    width="14"
    height="14"
    viewBox="0 0 14 14"
    fill="none"
    class="transition-transform duration-200 group-hover:translate-x-0.5"
    aria-hidden="true"
  >
    <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" />
  </svg>
</a>
