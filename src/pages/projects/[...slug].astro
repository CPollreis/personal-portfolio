---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import VideoEmbed from '../../components/content/VideoEmbed.astro';
import CoordinateAxis from '../../components/hud/CoordinateAxis.astro';
import HeaderMedia from '../../components/layout/HeaderMedia.astro';
import EntryKeyNav from '../../components/content/EntryKeyNav.astro';
import Step from '../../components/content/Step.astro';
import { withBase } from '../../config/paths';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime(),
  );
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { title, kind, stack, summary, links, cover, video, date, hero, heroVideo } = project.data;
const dateStr = date.toISOString().slice(0, 7);
const heroImg = hero ?? cover;
const isMedia = project.id.startsWith('raw-');
const hasHeroMedia = !isMedia && Boolean(heroVideo || heroImg);
const showCoverPlate = isMedia && Boolean(heroImg) && !/<Step\b/.test(project.body ?? '');
---

<Base title={title} description={summary}>
  <EntryKeyNav
    prevHref={prev ? withBase(`/projects/${prev.id}`) : undefined}
    nextHref={next ? withBase(`/projects/${next.id}`) : undefined}
    backHref={withBase('/#projects')}
  />
  {
    isMedia && (
      <div class="pointer-events-none fixed inset-x-0 top-0 z-50">
        <div class="container-hud flex h-16 items-center justify-end">
          <a
            href={withBase('/#projects')}
            aria-label="Close entry"
            class="pointer-events-auto flex h-9 w-9 items-center justify-center text-muted transition-colors hover:text-ink"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 3 13 13M13 3 3 13" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        </div>
      </div>
    )
  }
  <article class="pb-24">
    <header
      class:list={[
        'relative flex flex-col justify-end overflow-hidden border-b border-line',
        hasHeroMedia
          ? 'min-h-[clamp(22rem,52vh,34rem)] pt-24 pb-10 md:pb-14'
          : 'pt-28 pb-10 md:pb-14',
      ]}
    >
      {!isMedia && <HeaderMedia video={heroVideo} image={heroImg} focus="bottom" />}
      <div class="container-hud relative max-w-3xl">
        <div class="mb-5 flex flex-wrap items-center gap-3">
          <span class="hud-label text-accent">{kind}</span>
          <span class="h-2.5 w-px bg-line"></span>
          <span class="hud-label tabular">{dateStr}</span>
        </div>
        <h1 class="font-display text-4xl font-semibold leading-tight md:text-5xl">{title}</h1>
        <p class="mt-5 text-lg text-muted">{summary}</p>

        {
          !isMedia && stack.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-1.5">
              {stack.map((s) => (
                <span class="border border-line px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-muted">
                  {s}
                </span>
              ))}
            </div>
          )
        }

        {
          (links.repo || links.demo) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {links.repo && (
                <Button href={links.repo} external>
                  Source
                </Button>
              )}
              {links.demo && (
                <Button href={links.demo} variant="ghost" external>
                  Live demo
                </Button>
              )}
            </div>
          )
        }
      </div>
    </header>

    {
      video && (
        <div class="container-hud mt-10 max-w-3xl">
          <VideoEmbed url={video} title={title} />
        </div>
      )
    }

    <div class="prose-hud entry-body mt-12">
      {showCoverPlate && <Step figure={heroImg} alt={title} />}
      <Content />
    </div>

    <div class="container-hud max-w-3xl">
      {
        isMedia ? (
          <nav
            class="mt-16 flex items-center justify-between gap-4 border-t border-line pt-6 font-mono text-xs uppercase tracking-widest text-muted"
            aria-label="Adjacent projects"
          >
            {prev ? (
              <a
                href={withBase(`/projects/${prev.id}`)}
                class="flex items-center gap-2 transition-colors hover:text-ink"
              >
                <span aria-hidden="true">←</span> Prev
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a
                href={withBase(`/projects/${next.id}`)}
                class="flex items-center gap-2 transition-colors hover:text-ink"
              >
                Next <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        ) : (
          <div class="mt-16">
            <CoordinateAxis startLabel="EOF" endLabel="↑ TOP" />

            <nav class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="Adjacent projects">
              {prev ? (
                <a
                  href={withBase(`/projects/${prev.id}`)}
                  class="card-hud group border border-line bg-surface p-5 transition-colors"
                >
                  <span class="hud-label">← Previous</span>
                  <span class="mt-2 block font-display text-lg text-ink transition-colors group-hover:text-cyan">
                    {prev.data.title}
                  </span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a
                  href={withBase(`/projects/${next.id}`)}
                  class="card-hud group border border-line bg-surface p-5 text-right transition-colors"
                >
                  <span class="hud-label">Next →</span>
                  <span class="mt-2 block font-display text-lg text-ink transition-colors group-hover:text-cyan">
                    {next.data.title}
                  </span>
                </a>
              )}
            </nav>

            <a href={withBase('/#projects')} class="link-hud mt-8 inline-block font-mono text-xs uppercase tracking-widest text-muted hover:text-ink">
              ← Back to all projects
            </a>
          </div>
        )
      }
    </div>
  </article>
</Base>
