---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SubsystemBadge from '../components/fsae/SubsystemBadge.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import Button from '../components/ui/Button.astro';
import Placeholder from '../components/media/Placeholder.astro';
import MomentFrame from '../components/photography/MomentFrame.astro';
import MomentLightbox, { type Moment } from '../components/photography/MomentLightbox.tsx';
import { momentBackdrop } from '../components/photography/backdrop';
import { archiveShape } from '../components/photography/archiveGrid';
import { subsystems, type Subsystem } from '../config/fsae';
import { site, positions, socials } from '../config/site';
import { withBase } from '../config/paths';
import '../styles/moments.css';

const fsaePosts = (await getCollection('fsae', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime(),
);

type LogCat = 'fw' | 'mfg' | 'av' | 'prj';
const subsystemCat: Record<Subsystem, LogCat> = {
  firmware: 'fw',
  manufacturing: 'mfg',
  autonomous: 'av',
};
const feed = [
  ...fsaePosts.map((p) => ({
    href: withBase(`/fsae/${p.id}`),
    cat: subsystemCat[p.data.subsystem],
    subsystem: p.data.subsystem as Subsystem | null,
    code: subsystems[p.data.subsystem].code,
    title: p.data.title,
    summary: p.data.summary,
    date: p.data.date,
    cover: p.data.cover,
  })),
  ...projects.map((p) => ({
    href: withBase(`/projects/${p.id}`),
    cat: 'prj' as LogCat,
    subsystem: null as Subsystem | null,
    code: 'PRJ',
    title: p.data.title,
    summary: p.data.summary,
    date: p.data.date,
    cover: p.data.cover,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const catCount = (c: LogCat) => feed.filter((e) => e.cat === c).length;
const fsaeCount = catCount('fw') + catCount('mfg') + catCount('av');
const logFilters = [
  { id: 'all', label: 'All entries', count: feed.length, fc: 'var(--color-ink)', ftc: 'var(--color-bg)', level: 0 },
  { id: 'prj', label: 'Projects', count: catCount('prj'), fc: 'var(--color-ink)', ftc: 'var(--color-bg)', level: 0 },
  { id: 'fsae', label: 'FSAE', count: fsaeCount, fc: 'var(--color-accent)', ftc: 'var(--color-ink)', level: 0 },
  { id: 'av', label: 'Autonomy', count: catCount('av'), fc: 'var(--color-indigo)', ftc: 'var(--color-ink)', level: 1 },
  { id: 'fw', label: 'Firmware', count: catCount('fw'), fc: 'var(--color-accent)', ftc: 'var(--color-ink)', level: 1 },
  { id: 'mfg', label: 'Manufacturing', count: catCount('mfg'), fc: 'var(--color-cyan)', ftc: 'var(--color-bg)', level: 1 },
];
const photoFrames = (await getCollection('photography')).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime(),
);

const fmtMomentDate = (d: Date) =>
  d
    .toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    .toUpperCase();

// Serializable payload for the lightbox island.
const moments: Moment[] = photoFrames.map((f, i) => ({
  title: f.data.title,
  kind: f.data.kind,
  dateDisplay: fmtMomentDate(f.data.date),
  story: f.data.story,
  location: f.data.location,
  camera: f.data.camera,
  lens: f.data.lens,
  iso: f.data.iso,
  aperture: f.data.aperture,
  focal: f.data.focal,
  fps: f.data.fps,
  quality: f.data.quality,
  ratio: f.data.ratio,
  src: f.data.image?.src,
  video: f.data.video,
  backdrop: momentBackdrop(i),
}));

const momentFrameProps = (i: number) => ({
  index: i,
  title: photoFrames[i].data.title,
  year: String(photoFrames[i].data.date.getUTCFullYear()),
  kind: photoFrames[i].data.kind,
  ratio: photoFrames[i].data.ratio,
  image: photoFrames[i].data.image,
  video: photoFrames[i].data.video,
});

// Mosaic cells: shape ('tall' | 'std') comes straight from the ratio; the grid
// packs them with `grid-auto-flow: dense` so order + backfill do the layout.
const archiveCells = photoFrames.map((f, i) => ({ index: i, shape: archiveShape(f.data.ratio) }));

const fmtDate = (d: Date) =>
  d
    .toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    .toUpperCase();

const thumbFrame = 'border border-faint/50 transition-colors group-hover:border-faint';
---

<Base padTop={false}>
  <section class="relative flex min-h-[100dvh] flex-col justify-center overflow-hidden border-b border-line pt-16 md:h-[100dvh]">
    <div class="absolute inset-0" aria-hidden="true">
      <video
        data-header-video
        class="h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        tabindex="-1"
      >
        <!-- stabilized variants (ffmpeg vidstab from hero-loop.MP4); webm first:
             Firefox's macOS H.264 decoder can fail after client-side navigation
             (see src/scripts/footage.ts); VP9 decodes in software -->
        <source src={withBase('/videos/hero-loop-stab-web.webm')} type="video/webm" />
        <source src={withBase('/videos/hero-loop-stab-web.mp4')} type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-bg/40"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-bg/85 via-bg/35 via-45% to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-bg to-transparent"></div>
    </div>

    <div class="container-hud relative flex min-h-0 flex-1 flex-col justify-center py-[clamp(1rem,4vh,3rem)]">
      <div class="flex min-h-0 w-fit max-w-lg flex-col">
        <div class="shrink-0 border border-line/80 bg-bg/60 p-6 backdrop-blur-md md:p-8">
          <h1 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">
            Caleb <span class="text-grad">Pollreis</span>
          </h1>

          <ul class="mt-5 space-y-1.5">
            {
              positions.map((p) => (
                <li class="text-sm text-muted">
                  {p.href ? (
                    <a href={p.href} class="link-hud text-ink">{p.role}</a>
                  ) : (
                    <span class="text-ink">{p.role}</span>
                  )}
                  <span class="text-faint"> · </span>{p.org}
                  {p.note && <span class="mt-0.5 block font-medium text-cyan">{p.note}</span>}
                </li>
              ))
            }
          </ul>

          <p class="mt-5 max-w-sm text-sm leading-relaxed text-muted">
            I'm a computer engineering student working in autonomous systems, robotics,
            and embedded software. I've shipped C++/ROS2 perception on NVIDIA Jetson
            across two internships, and I lead the 10-person team building the driverless
            system for our FSAE electric car, targeting autonomy by 2028.
          </p>

          <p class="mt-6 flex items-center gap-2.5">
            <span class="h-1.5 w-1.5 rounded-full bg-cyan" aria-hidden="true"></span>
            <span class="hud-label text-ink">{site.availability}</span>
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
            <div class="flex flex-wrap gap-3">
              <Button href="#posts">My work</Button>
              <Button href={site.resume} external>Resume</Button>
            </div>

            <ul class="flex translate-y-[2px] items-center gap-x-6">
              {
                socials.map((s) => (
                  <li>
                    <a
                      href={s.href}
                      class="link-hud inline-flex text-muted hover:text-ink"
                      aria-label={s.label}
                      rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                      target={s.href.startsWith('http') ? '_blank' : undefined}
                    >
                      <SocialIcon
                        label={s.label}
                        class={
                          s.label === 'Email'
                            ? 'h-10 w-10'
                            : s.label === 'GitHub'
                              ? 'h-9 w-9'
                              : 'h-8 w-8'
                        }
                      />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="mt-6 aspect-[4/3] max-h-[16dvh] w-full min-h-0 shrink md:max-h-none [@media(max-height:700px)]:hidden [@media(max-width:374px)]:hidden">
          <Placeholder ratio="auto" label="CP · REPLACE" seed={3} class="!h-full !w-full !border-faint/50" />
        </div>
      </div>
    </div>
  </section>

  <section id="fsae" class="scroll-mt-16">
    <div class="container-hud pt-16 pb-12 md:pt-24 md:pb-16">
      <p id="projects" class="hud-title scroll-mt-16 border-b border-line pb-3">
        Posts · {feed.length} entries
      </p>

      <div id="posts" class="mt-6 scroll-mt-16 md:grid md:grid-cols-[200px_minmax(0,1fr)] md:items-start md:gap-8">
        <nav class="hidden md:sticky md:top-20 md:block" aria-label="Filter the posts">
          <div class="mb-1 flex items-center gap-2 border-b border-line px-3.5 pb-2.5">
            <svg class="h-3 w-3 shrink-0 text-cyan" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M1 2h10l-4 4.5V11L5 9.5V6.5L1 2Z"
                stroke="currentColor"
                stroke-width="1"
                stroke-linejoin="round"
              />
            </svg>
            <span class="font-mono text-[0.625rem] uppercase tracking-[0.18em] text-ink">Filter</span>
            <button
              type="button"
              data-log-reset
              class="ml-auto font-mono text-[0.5625rem] uppercase tracking-[0.14em] text-faint transition-colors hover:text-ink"
            >
              Reset
            </button>
          </div>
          <ul class="border-l border-line">
            {
              logFilters.map((f) => (
                <li>
                  <button
                    type="button"
                    data-log-filter={f.id}
                    aria-pressed={f.id === 'all' ? 'true' : 'false'}
                    style={`--fc:${f.fc}`}
                    class:list={[
                      '-ml-px flex w-full items-center justify-between gap-4 border-l-2 border-transparent py-2.5 pr-3.5 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-muted transition-colors hover:text-ink aria-pressed:border-(--fc) aria-pressed:bg-raised aria-pressed:text-ink',
                      f.level === 1 ? 'pl-8' : 'pl-3.5',
                    ]}
                  >
                    <span>{f.label}</span>
                    <span class="tabular text-faint">{f.count}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <div class="mb-6 flex flex-wrap gap-2 md:hidden" role="group" aria-label="Filter the posts">
            {
              logFilters.map((f) => (
                <button
                  type="button"
                  data-log-filter={f.id}
                  aria-pressed={f.id === 'all' ? 'true' : 'false'}
                  style={`--fc:${f.fc};--ftc:${f.ftc}`}
                  class="bg-raised px-3.5 py-2 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-muted transition-colors [clip-path:polygon(0_0,calc(100%-8px)_0,100%_8px,100%_100%,0_100%)] aria-pressed:bg-(--fc) aria-pressed:text-(--ftc)"
                >
                  {f.label} <span class="tabular opacity-70">{f.count}</span>
                </button>
              ))
            }
          </div>

          {
            feed.length > 0 && (
              <a
                href={feed[0].href}
                data-log-entry
                data-cat={feed[0].cat}
                class="group grid gap-6 md:grid-cols-[3fr_2fr] md:items-center"
              >
                {feed[0].cover ? (
                  <div class={thumbFrame}>
                    <Image
                      src={feed[0].cover}
                      alt={feed[0].title}
                      widths={[720, 1440]}
                      sizes="(min-width: 768px) 60vw, 100vw"
                      class="aspect-video w-full object-cover"
                    />
                  </div>
                ) : (
                  <Placeholder
                    ratio="16/9"
                    label={`${feed[0].code} · FIG.LEAD`}
                    seed={0}
                    class="!border-faint/50 transition-colors group-hover:!border-faint"
                  />
                )}
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    {feed[0].subsystem ? (
                      <SubsystemBadge subsystem={feed[0].subsystem} />
                    ) : (
                      <span class="inline-flex items-center gap-1.5 border border-ink/45 px-2 py-1 font-mono text-[0.65rem] uppercase tracking-wider text-ink">
                        <span class="h-1.5 w-1.5 bg-ink" />
                        Project
                      </span>
                    )}
                    <span class="hud-label tabular">{fmtDate(feed[0].date)}</span>
                  </div>
                  <h3 class="mt-3 font-display text-xl text-ink transition-colors group-hover:text-cyan md:text-2xl">
                    {feed[0].title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{feed[0].summary}</p>
                  <span class="hud-label mt-4 inline-flex transition-colors group-hover:text-cyan">
                    Read the entry →
                  </span>
                </div>
              </a>
            )
          }
          <ul class="mt-10 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
            {
              feed.slice(1).map((e, i) => (
                <li data-log-entry data-cat={e.cat}>
                  <a href={e.href} class="group block">
                    {e.cover ? (
                      <div class={thumbFrame}>
                        <Image
                          src={e.cover}
                          alt={e.title}
                          widths={[480, 960]}
                          sizes="(min-width: 1024px) 430px, (min-width: 640px) 50vw, 100vw"
                          class="aspect-video w-full object-cover"
                        />
                      </div>
                    ) : (
                      <Placeholder
                        ratio="16/9"
                        label={`${e.code} · FIG.0${i + 2}`}
                        seed={i + 1}
                        class="!border-faint/50 transition-colors group-hover:!border-faint"
                      />
                    )}
                    <div class="mt-3 flex flex-wrap items-center gap-3">
                      {e.subsystem ? (
                        <SubsystemBadge subsystem={e.subsystem} />
                      ) : (
                        <span class="inline-flex items-center gap-1.5 border border-ink/45 px-2 py-1 font-mono text-[0.65rem] uppercase tracking-wider text-ink">
                          <span class="h-1.5 w-1.5 bg-ink" />
                          Project
                        </span>
                      )}
                      <span class="hud-label tabular">{fmtDate(e.date)}</span>
                    </div>
                    <h3 class="mt-2 font-display text-base text-ink transition-colors group-hover:text-cyan">
                      {e.title}
                    </h3>
                    <p class="mt-1 line-clamp-2 text-sm text-muted">{e.summary}</p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="photography" class="moments moments-inline scroll-mt-16 border-b border-line">
    <div class="container-hud pt-12 pb-16 md:pt-16 md:pb-24">
      <p class="hud-title border-b border-line pb-3">Photography</p>

      <div class="m-archive mt-8">
        <div class="m-archive-grid">
          {
            archiveCells.map((c) => (
              <div class={`m-cell-${c.shape}`} data-reveal>
                <MomentFrame {...momentFrameProps(c.index)} fill />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <MomentLightbox client:load moments={moments} />
  </section>
</Base>

<script>
  /* Posts filter: rail (desktop) and chips (mobile) share [data-log-filter]
     buttons and toggle [data-log-entry] cards by data-cat. The `fsae` filter is
     a parent that matches all three subsystems (fw/mfg/av). Clicking the active
     filter again clears back to all.

     Deep-links preselect a filter: #projects -> Projects (Nav breadcrumb, 404,
     project pages), #posts -> All entries (hero Work button).
     Two arrival paths, handled separately: cross-page nav fires astro:page-load
     (initLogFilter re-runs and reads location.hash); a same-page hero click is
     intercepted by ClientRouter, which updates the hash via history.pushState
     with NO hashchange event and NO swap, so we also bind the filter straight
     onto those anchors' click. Nodes are fresh after every swap, so everything
     re-initializes on astro:page-load. */
  const HASH_FILTER: Record<string, string> = { '#projects': 'prj', '#posts': 'all' };
  const FSAE_CATS = new Set(['fw', 'mfg', 'av']);
  const showsEntry = (id: string, cat: string) =>
    id === 'all' || cat === id || (id === 'fsae' && FSAE_CATS.has(cat));
  let hashHandler: (() => void) | undefined;

  function initLogFilter() {
    const root = document.getElementById('posts');
    if (hashHandler) {
      window.removeEventListener('hashchange', hashHandler);
      hashHandler = undefined;
    }
    if (!root) return;

    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-log-filter]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-log-entry]'));
    let active = 'all';

    const set = (id: string) => {
      active = id;
      for (const b of btns) b.setAttribute('aria-pressed', String(b.dataset.logFilter === id));
      for (const el of items) {
        el.style.display = showsEntry(id, el.dataset.cat ?? '') ? '' : 'none';
      }
    };

    for (const b of btns) {
      b.addEventListener('click', () => {
        const id = b.dataset.logFilter ?? 'all';
        set(id === active && id !== 'all' ? 'all' : id);
      });
    }

    // Filter header reset: clears back to All entries.
    root.querySelector<HTMLButtonElement>('[data-log-reset]')?.addEventListener('click', () => set('all'));

    // Hero deep-link anchors: set the filter on click (the default scroll to the
    // target still runs). Covers the same-page case that hashchange misses.
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
      const id = HASH_FILTER[a.getAttribute('href') ?? ''];
      if (id) a.addEventListener('click', () => set(id));
    }

    hashHandler = () => {
      const id = HASH_FILTER[location.hash];
      if (id) set(id);
    };
    window.addEventListener('hashchange', hashHandler);

    set('all');
    hashHandler();
  }

  document.addEventListener('astro:page-load', initLogFilter);
</script>

<script>
  /* Archive films play only while on screen: [data-scrollplay] videos are
     excluded from footage.ts's always-on management (that owns the hero
     footage), so this observer owns their playback. Nodes are fresh after
     every ClientRouter swap; the old observer is dropped wholesale and
     rebuilt. */
  let playIO: IntersectionObserver | undefined;

  function initScrollPlay() {
    playIO?.disconnect();
    const vids = Array.from(
      document.querySelectorAll<HTMLVideoElement>('video[data-scrollplay]'),
    );
    if (!vids.length) return;

    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
      vids.forEach((v) => v.pause());
      return;
    }

    playIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            v.muted = true; // required for programmatic autoplay
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.2 },
    );
    vids.forEach((v) => playIO!.observe(v));
  }

  document.addEventListener('astro:page-load', initScrollPlay);
</script>
