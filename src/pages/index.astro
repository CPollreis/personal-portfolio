---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SubsystemBadge from '../components/fsae/SubsystemBadge.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import Button from '../components/ui/Button.astro';
import Placeholder from '../components/media/Placeholder.astro';
import MomentFrame from '../components/photography/MomentFrame.astro';
import MomentLightbox, { type Moment } from '../components/photography/MomentLightbox.tsx';
import { momentBackdrop } from '../components/photography/backdrop';
import { archiveShape } from '../components/photography/archiveGrid';
import { readPhotoExif, type PhotoExif } from '../components/photography/exif';
import { subsystems, type Subsystem } from '../config/fsae';
import { site, positions, socials } from '../config/site';
import { withBase } from '../config/paths';
import { assetUrl, assetRecord, type AssetExif } from '../data/assets';
import headshot from '../assets/headshot.jpg';
import '../styles/moments.css';

const fsaePosts = (await getCollection('fsae', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime(),
);

const projectEntries = projects.map((p) => ({
  href: withBase(`/projects/${p.id}`),
  subsystem: null as Subsystem | null,
  code: 'PRJ',
  title: p.data.title,
  summary: p.data.summary,
  date: p.data.date,
  cover: p.data.cover,
}));

const fsaeEntries = fsaePosts.map((p) => ({
  href: withBase(`/fsae/${p.id}`),
  subsystem: p.data.subsystem as Subsystem | null,
  code: subsystems[p.data.subsystem].code,
  title: p.data.title,
  summary: p.data.summary,
  date: p.data.date,
  cover: p.data.cover,
}));

const feedSections = [
  { id: 'projects', title: 'Projects', entries: projectEntries },
  { id: 'fsae', title: 'FSAE', entries: fsaeEntries },
];
const photoFrames = (await getCollection('photography')).sort(
  (a, b) =>
    a.data.order - b.data.order || (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);

const fmtMomentDate = (d: Date) =>
  d
    .toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    .toUpperCase();

const PHOTO_DIR = 'src/content/photography';
const rawImageRef = (id: string): string | null => {
  try {
    const src = fs.readFileSync(path.join(PHOTO_DIR, `${id}.md`), 'utf8');
    const m = src.match(/^\s*image:\s*["']?([^"'\n#]+?)["']?\s*(?:#.*)?$/m);
    return m ? m[1].trim() : null;
  } catch {
    return null;
  }
};

const manifestExif = (e: AssetExif): PhotoExif => ({
  takenAt: e.takenAt ? new Date(e.takenAt) : null,
  iso: e.iso,
  aperture: e.aperture,
  shutter: e.shutter,
  camera: e.camera,
  lens: e.lens,
  focal: e.focal,
});

const photoExif = await Promise.all(
  photoFrames.map((f) => {
    const rec = f.data.full ? assetRecord(f.data.full) : undefined;
    if (rec?.exif) return manifestExif(rec.exif);
    if (!f.data.image) return null;
    const ref = rawImageRef(f.id);
    return ref ? readPhotoExif(path.resolve(PHOTO_DIR, ref)) : null;
  }),
);

const photoMeta = photoFrames.map((f, i) => {
  const ex = photoExif[i];
  const date = f.data.date ?? ex?.takenAt ?? null;
  return {
    title: f.data.title ?? '',
    dateDisplay: date ? fmtMomentDate(date) : '',
    year: date ? String(date.getUTCFullYear()) : '',
    iso: f.data.iso ?? ex?.iso ?? undefined,
    aperture: f.data.aperture ?? ex?.aperture ?? undefined,
    shutter: f.data.shutter ?? ex?.shutter ?? undefined,
    camera: f.data.camera ?? ex?.camera ?? 'Sony a6400',
    lens: f.data.lens ?? ex?.lens ?? undefined,
    focal: f.data.focal ?? ex?.focal ?? undefined,
  };
});

// Serializable payload for the lightbox island.
const moments: Moment[] = photoFrames.map((f, i) => ({
  title: photoMeta[i].title || undefined,
  kind: f.data.kind,
  dateDisplay: photoMeta[i].dateDisplay,
  story: f.data.story,
  location: f.data.location,
  camera: photoMeta[i].camera,
  lens: photoMeta[i].lens,
  iso: photoMeta[i].iso,
  aperture: photoMeta[i].aperture,
  shutter: photoMeta[i].shutter,
  focal: photoMeta[i].focal,
  fps: f.data.fps,
  quality: f.data.quality,
  ratio: f.data.ratio,
  src: f.data.image?.src,
  downloadUrl: f.data.full ? assetUrl(f.data.full) : undefined,
  video: f.data.video,
  backdrop: momentBackdrop(i),
}));

const missingFull = photoFrames
  .filter((f) => f.data.full && !assetUrl(f.data.full))
  .map((f) => `${f.id}: full "${f.data.full}"`);
if (missingFull.length) {
  throw new Error(
    `asset-manifest.json is missing keys referenced by photography frontmatter:\n  ${missingFull.join('\n  ')}\n` +
      'Run: node scripts/publish-assets.mjs --dir <originals>',
  );
}

const momentFrameProps = (i: number) => ({
  index: i,
  title: photoMeta[i].title,
  year: photoMeta[i].year,
  kind: photoFrames[i].data.kind,
  ratio: photoFrames[i].data.ratio,
  image: photoFrames[i].data.image,
  video: photoFrames[i].data.video,
});

// Mosaic cells: shape ('tall' | 'std') comes straight from the ratio; the grid
// packs them with `grid-auto-flow: dense` so order + backfill do the layout.
const archiveCells = photoFrames.map((f, i) => ({ index: i, shape: archiveShape(f.data.ratio) }));

const fmtDate = (d: Date) =>
  d
    .toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    .toUpperCase();

const thumbFrame = 'border border-faint/50 transition-colors group-hover:border-faint';
---

<Base padTop={false}>
  <section class="relative flex min-h-[100dvh] flex-col justify-center overflow-hidden border-b border-line pt-16 md:h-[100dvh]">
    <div class="absolute inset-0" aria-hidden="true">
      <video
        data-header-video
        class="h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        tabindex="-1"
      >
        <!-- stabilized variants (ffmpeg vidstab from hero-loop.MP4); webm first:
             Firefox's macOS H.264 decoder can fail after client-side navigation
             (see src/scripts/footage.ts); VP9 decodes in software -->
        <source src={withBase('/videos/hero-loop-stab-web.webm')} type="video/webm" />
        <source src={withBase('/videos/hero-loop-stab-web.mp4')} type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-bg/40"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-bg/85 via-bg/35 via-45% to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-bg to-transparent"></div>
    </div>

    <div class="container-hud relative flex min-h-0 flex-1 flex-col justify-center py-[clamp(1rem,4vh,3rem)]">
      <div class="flex min-h-0 w-fit max-w-2xl flex-col">
        <div class="shrink-0 border border-line/80 bg-bg/60 p-6 backdrop-blur-md md:p-8">
          <h1 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">
            Caleb <span class="text-grad">Pollreis</span>
          </h1>

          <div class="mt-5 flex flex-col">
            <div class="flex flex-col gap-x-4 gap-y-5 sm:flex-row sm:items-start">
              <div class="aspect-[4/5] w-52 shrink-0 self-start border border-faint/50 md:w-60">
                <Image
                  src={headshot}
                  alt="Caleb Pollreis"
                  widths={[208, 240, 416, 480]}
                  sizes="(min-width: 768px) 240px, 208px"
                  class="h-full w-full object-cover object-top"
                />
              </div>

              <div class="w-64 min-w-0 max-w-full">
                <ul class="space-y-2">
                  {
                    positions.map((p) => (
                      <li class="text-sm text-muted">
                        {p.href ? (
                          <a href={p.href} class="link-hud text-ink">{p.role.replace(/-/g, '‑')}</a>
                        ) : (
                          <span class="text-ink">{p.role.replace(/-/g, '‑')}</span>
                        )}
                        <span class="block whitespace-nowrap">{p.org}</span>
                        {p.note && <span class="mt-0.5 block font-medium text-cyan">{p.note}</span>}
                      </li>
                    ))
                  }
                </ul>

                <p class="mt-5 text-sm leading-relaxed text-muted">
                  I'm a computer engineering student working in autonomous systems, robotics,
                  and embedded software. I&nbsp;lead the 10-person team building the driverless
                  system for our FSAE electric car, targeting autonomy by 2028.
                </p>
              </div>
            </div>

            <p class="hud-label my-10 text-center text-ink">
              {site.availability}
            </p>

            <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-8">
              <div class="flex w-52 gap-3 md:w-60">
                <Button href="#projects" size="sm" class="flex-1 justify-center">My work</Button>
                <Button href={site.resume} external size="sm" class="flex-1 justify-center">Resume</Button>
              </div>

              <ul class="flex items-center gap-x-7 sm:ml-auto">
                {
                  socials.map((s) => (
                    <li>
                      <a
                        href={s.href}
                        class="link-hud inline-flex text-muted hover:text-ink"
                        aria-label={s.label}
                        rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                        target={s.href.startsWith('http') ? '_blank' : undefined}
                      >
                        <SocialIcon
                          label={s.label}
                          class={
                            s.label === 'Email'
                              ? 'h-9 w-9'
                              : s.label === 'GitHub'
                                ? 'h-8 w-8'
                                : 'h-7 w-7'
                          }
                        />
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    feedSections.map((sec, si) => (
      <section id={sec.id} class:list={['scroll-mt-16', si > 0 && 'border-t border-line']}>
        <div class="container-hud pt-6 pb-6 md:pt-8 md:pb-8">
          <p class="hud-title">{sec.title} · {sec.entries.length} entries</p>

          <div class="mt-6">
            {sec.entries.length > 0 && (
              <a
                href={sec.entries[0].href}
                class="group grid gap-6 md:grid-cols-[3fr_2fr] md:items-center"
              >
                {sec.entries[0].cover ? (
                  <div class={thumbFrame}>
                    <Image
                      src={sec.entries[0].cover}
                      alt={sec.entries[0].title}
                      widths={[720, 1440]}
                      sizes="(min-width: 768px) 60vw, 100vw"
                      class="aspect-video w-full object-cover"
                    />
                  </div>
                ) : (
                  <Placeholder
                    ratio="16/9"
                    label={`${sec.entries[0].code} · FIG.LEAD`}
                    seed={0}
                    class="!border-faint/50 transition-colors group-hover:!border-faint"
                  />
                )}
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    {sec.entries[0].subsystem ? (
                      <SubsystemBadge subsystem={sec.entries[0].subsystem} />
                    ) : (
                      <span class="inline-flex items-center gap-1.5 border border-ink/45 px-2 py-1 font-mono text-[0.65rem] uppercase tracking-wider text-ink">
                        <span class="h-1.5 w-1.5 bg-ink" />
                        Project
                      </span>
                    )}
                    <span class="hud-label tabular">{fmtDate(sec.entries[0].date)}</span>
                  </div>
                  <h3 class="mt-3 font-display text-xl text-ink transition-colors group-hover:text-cyan md:text-2xl">
                    {sec.entries[0].title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{sec.entries[0].summary}</p>
                  <span class="hud-label mt-4 inline-flex transition-colors group-hover:text-cyan">
                    Read the entry →
                  </span>
                </div>
              </a>
            )}

            {sec.entries.length > 1 && (
              <ul class="mt-10 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
                {sec.entries.slice(1).map((e, i) => (
                  <li>
                    <a href={e.href} class="group block">
                      {e.cover ? (
                        <div class={thumbFrame}>
                          <Image
                            src={e.cover}
                            alt={e.title}
                            widths={[480, 960]}
                            sizes="(min-width: 1024px) 430px, (min-width: 640px) 50vw, 100vw"
                            class="aspect-video w-full object-cover"
                          />
                        </div>
                      ) : (
                        <Placeholder
                          ratio="16/9"
                          label={`${e.code} · FIG.0${i + 2}`}
                          seed={i + 1}
                          class="!border-faint/50 transition-colors group-hover:!border-faint"
                        />
                      )}
                      <div class="mt-3 flex flex-wrap items-center gap-3">
                        {e.subsystem ? (
                          <SubsystemBadge subsystem={e.subsystem} />
                        ) : (
                          <span class="inline-flex items-center gap-1.5 border border-ink/45 px-2 py-1 font-mono text-[0.65rem] uppercase tracking-wider text-ink">
                            <span class="h-1.5 w-1.5 bg-ink" />
                            Project
                          </span>
                        )}
                        <span class="hud-label tabular">{fmtDate(e.date)}</span>
                      </div>
                      <h3 class="mt-2 font-display text-base text-ink transition-colors group-hover:text-cyan">
                        {e.title}
                      </h3>
                      <p class="mt-1 line-clamp-2 text-sm text-muted">{e.summary}</p>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      </section>
    ))
  }

  <section id="photography" class="moments moments-inline scroll-mt-16 border-b border-line">
    <div class="container-hud pt-4 pb-4 md:pt-6 md:pb-6">
      <p class="hud-title">Photography</p>

      <div class="m-archive mt-8">
        <div class="m-archive-grid">
          {
            archiveCells.map((c) => (
              <div class={`m-cell-${c.shape}`} data-reveal>
                <MomentFrame {...momentFrameProps(c.index)} fill />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <MomentLightbox client:load moments={moments} />
  </section>
</Base>

<script>
  /* Archive films play only while on screen: [data-scrollplay] videos are
     excluded from footage.ts's always-on management (that owns the hero
     footage), so this observer owns their playback. Nodes are fresh after
     every ClientRouter swap; the old observer is dropped wholesale and
     rebuilt. */
  let playIO: IntersectionObserver | undefined;

  function initScrollPlay() {
    playIO?.disconnect();
    const vids = Array.from(
      document.querySelectorAll<HTMLVideoElement>('video[data-scrollplay]'),
    );
    if (!vids.length) return;

    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
      vids.forEach((v) => v.pause());
      return;
    }

    playIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            v.muted = true; // required for programmatic autoplay
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.2 },
    );
    vids.forEach((v) => playIO!.observe(v));
  }

  document.addEventListener('astro:page-load', initScrollPlay);
</script>
